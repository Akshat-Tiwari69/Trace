{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-resilience.local/schemas/a46-run-manifest-v1.json",
  "title": "A46 graph-first experiment run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "purpose",
    "redistribution_allowed",
    "licenses",
    "code",
    "data",
    "model",
    "environment",
    "inference",
    "promotion_contract"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "redistribution_allowed": {"type": "boolean"},
    "licenses": {"type": "object"},
    "code": {
      "type": "object",
      "required": [
        "trace_git_sha",
        "samroadplus_upstream_git_sha",
        "samroadplus_local_patch_sha256"
      ],
      "properties": {
        "trace_git_sha": {"type": "string", "minLength": 1},
        "samroadplus_upstream_git_sha": {"type": "string", "minLength": 1},
        "samroadplus_local_patch_sha256": {"type": "string", "minLength": 1}
      }
    },
    "data": {
      "type": "object",
      "required": [
        "selection_manifest_sha256",
        "selection_key",
        "chip_count",
        "chip_ids",
        "coordinate_contract"
      ],
      "properties": {
        "selection_manifest_sha256": {"type": "string", "minLength": 1},
        "selection_key": {"type": "string", "minLength": 1},
        "chip_count": {"type": "integer", "minimum": 1},
        "chip_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "coordinate_contract": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "required": [
        "checkpoint_sha256",
        "epoch",
        "config_sha256",
        "effective_config_sha256",
        "sam_checkpoint_sha256"
      ],
      "properties": {
        "checkpoint_sha256": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 0},
        "config_sha256": {"type": "string", "minLength": 1},
        "effective_config_sha256": {"type": "string", "minLength": 1},
        "sam_checkpoint_sha256": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "torch",
        "lightning",
        "cuda_runtime",
        "cudnn",
        "gpu",
        "deterministic_algorithms",
        "historical_checkpoint_reproducibility"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "torch": {"type": "string", "minLength": 1},
        "lightning": {"type": "string", "minLength": 1},
        "cuda_runtime": {"type": ["string", "null"]},
        "cudnn": {"type": ["integer", "string", "null"]},
        "gpu": {"type": "string", "minLength": 1},
        "deterministic_algorithms": {"type": "boolean"},
        "historical_checkpoint_reproducibility": {"type": "string", "minLength": 1}
      }
    },
    "inference": {
      "type": "object",
      "required": [
        "command",
        "thresholds",
        "wall_seconds_inference",
        "graph_count",
        "graphs_sha256"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "thresholds": {"type": "object"},
        "wall_seconds_inference": {"type": "number", "exclusiveMinimum": 0},
        "graph_count": {"type": "integer", "minimum": 1},
        "graphs_sha256": {"type": "string", "minLength": 1}
      }
    },
    "promotion_contract": {
      "type": "object",
      "required": [
        "selection_split_only",
        "min_candidate_minus_incumbent_raw_apls",
        "min_candidate_normalized_apls",
        "comparison_split_runs_allowed_after_preregistration"
      ],
      "properties": {
        "selection_split_only": {"type": "boolean"},
        "min_candidate_minus_incumbent_raw_apls": {"type": "number", "minimum": 0},
        "min_candidate_normalized_apls": {"type": "number", "minimum": 0},
        "comparison_split_runs_allowed_after_preregistration": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": true
}
