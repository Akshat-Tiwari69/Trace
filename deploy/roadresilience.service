[Unit]
Description=Route Resilience — FastAPI and static web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Trace
Environment=PYTHONPATH=%h/Trace
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/.config/roadresilience/env
# One worker owns the CPU queue; Caddy is the only public entrypoint.
ExecStart=%h/Trace/.venv/bin/uvicorn src.app.api:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Trace/data/outputs
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
