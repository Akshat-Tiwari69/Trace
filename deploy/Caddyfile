# Route Resilience — public HTTPS reverse proxy (Caddy, on the Oracle box).
# Auto-provisions a Let's Encrypt cert for the domain and proxies to the
# Streamlit dashboard on :8501 (websockets handled transparently).
# Install: place at /etc/caddy/Caddyfile, then `sudo systemctl restart caddy`.
# Needs 80 + 443 open in BOTH the Oracle Security List and the box iptables.
trace.tiwaribabu.in {
    reverse_proxy localhost:8501
}
